{
  "uid": "otel-order-payment",
  "title": "Order and Payment",
  "description": "Request volume, latency, errors, logs, and traces for order-service and payment-service. Headline counts are since each JVM started. Charts, logs, and traces follow the time picker.",
  "tags": ["opentelemetry", "demo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "editable": true,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "order-service,payment-service",
        "includeAll": true,
        "allValue": "order-service|payment-service",
        "multi": true,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "options": [
          {"selected": true, "text": "All", "value": "$__all"},
          {"selected": false, "text": "order-service", "value": "order-service"},
          {"selected": false, "text": "payment-service", "value": "payment-service"}
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Orders",
      "description": "POST /orders responses since order-service started.",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "sum(http_server_request_duration_count{job=\"order-service\", http_route=\"/orders\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Payments",
      "description": "POST /payments responses since payment-service started.",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "sum(http_server_request_duration_count{job=\"payment-service\", http_route=\"/payments\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Order error ratio",
      "description": "Share of POST /orders responses with HTTP 5xx. Declines return 502.",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "sum(http_server_request_duration_count{job=\"order-service\", http_route=\"/orders\", http_response_status_code=~\"5..\"}) / sum(http_server_request_duration_count{job=\"order-service\", http_route=\"/orders\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.05},
              {"color": "red", "value": 0.2}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Payment error ratio",
      "description": "Share of POST /payments responses with HTTP 5xx. Declines return 500.",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "sum(http_server_request_duration_count{job=\"payment-service\", http_route=\"/payments\", http_response_status_code=~\"5..\"}) / sum(http_server_request_duration_count{job=\"payment-service\", http_route=\"/payments\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.05},
              {"color": "red", "value": 0.2}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Order p90",
      "description": "90th percentile of POST /orders server duration.",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "histogram_quantile(0.9, sum by (le) (http_server_request_duration_bucket{job=\"order-service\", http_route=\"/orders\"}))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Payment p90",
      "description": "90th percentile of POST /payments server duration. Slow approvals reach 2 seconds.",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "histogram_quantile(0.9, sum by (le) (http_server_request_duration_bucket{job=\"payment-service\", http_route=\"/payments\"}))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate",
      "description": "HTTP server request rate from the Java agent.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "sum by (job, http_route) (rate(http_server_request_duration_count{job=~\"$service\", http_route=~\"/orders|/payments\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "fillOpacity": 15, "spanNulls": false}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Server latency",
      "description": "p90 and p99 of the HTTP server histogram. Exemplars link to Tempo when a sample carries a trace id.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "histogram_quantile(0.9, sum by (le, job) (rate(http_server_request_duration_bucket{job=~\"$service\", http_route=~\"/orders|/payments\"}[$__rate_interval])))",
          "legendFormat": "{{job}} p90",
          "exemplar": true
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "histogram_quantile(0.99, sum by (le, job) (rate(http_server_request_duration_bucket{job=~\"$service\", http_route=~\"/orders|/payments\"}[$__rate_interval])))",
          "legendFormat": "{{job}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 10, "spanNulls": false}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Responses by status",
      "description": "HTTP status counts for the two API routes.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "sum by (job, http_response_status_code) (http_server_request_duration_count{job=~\"$service\", http_route=~\"/orders|/payments\"})",
          "legendFormat": "{{job}} {{http_response_status_code}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byRegexp", "options": "/ 5../"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Service edges",
      "description": "Calls recorded by Tempo's service graph: caller, Payment, and PostgreSQL.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "sum by (client, server) (last_over_time(traces_service_graph_request_total{client=~\"$service|user\"}[$__range]))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true},
            "renameByName": {"Value": "Requests", "client": "From", "server": "To"}
          }
        },
        {
          "id": "sortBy",
          "options": {"fields": {}, "sort": [{"field": "Requests", "desc": true}]}
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 0, "custom": {"align": "auto"}},
        "overrides": []
      },
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Order to Payment latency",
      "description": "Client span from order-service to payment-service, split by the status Payment returned.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "histogram_quantile(0.9, sum by (le, http_response_status_code) (rate(http_client_request_duration_bucket{job=\"order-service\", server_address=\"payment-service\"}[$__rate_interval])))",
          "legendFormat": "p90 HTTP {{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 10, "spanNulls": false}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "SQL span latency",
      "description": "p90 of INSERT, UPDATE, and SELECT spans generated by Tempo from traces. The random payment wait is not in these spans.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "histogram_quantile(0.9, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_name=~\"INSERT .+|UPDATE .+|SELECT .+\"}[$__rate_interval])))",
          "legendFormat": "{{span_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 10, "spanNulls": false}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Database connections",
      "description": "Hikari pool usage. pool_name identifies orderdb or paymentdb.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "sum by (job, state) (db_client_connections_usage{job=~\"$service\"})",
          "legendFormat": "{{job}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 15, "spanNulls": true}, "min": 0},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "JVM heap",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 28},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "sum by (job) (jvm_memory_used{job=~\"$service\", jvm_memory_type=\"heap\"})",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "fillOpacity": 15, "spanNulls": true}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "JVM CPU",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 28},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "jvm_cpu_recent_utilization{job=~\"$service\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"drawStyle": "line", "fillOpacity": 15, "spanNulls": true}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "JVM threads",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 28},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "mimir"},
          "expr": "jvm_thread_count{job=~\"$service\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 15, "spanNulls": true}, "min": 0},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 17,
      "type": "logs",
      "title": "Application logs",
      "description": "Order and Payment lines that include orderId. trace_id opens the trace in Tempo.",
      "gridPos": {"h": 12, "w": 14, "x": 0, "y": 36},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{service_name=~\"$service\"} |~ \"orderId=\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 18,
      "type": "table",
      "title": "Recent order traces",
      "description": "TraceQL search for POST /orders. Open a row to see the Payment and database spans.",
      "gridPos": {"h": 12, "w": 10, "x": 14, "y": 36},
      "datasource": {"type": "tempo", "uid": "tempo"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "tempo", "uid": "tempo"},
          "queryType": "traceql",
          "query": "{ resource.service.name = \"order-service\" && name = \"POST /orders\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}}
    }
  ]
}
